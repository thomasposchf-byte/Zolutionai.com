---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import Chat from '../components/Chat.astro';
import { SITE } from '../data/site.mjs';
import { baseGraph } from '../lib/schema.mjs';
// Precarga de las fuentes principales para evitar saltos de diseño al cargar.
import fontDisplay from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import fontBody from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path: string;
  pageName: string;
  schema?: object[];
  noindex?: boolean;
  cta?: boolean;
  chips?: string[];
  nudge?: [string, string];
}
const { title, description, path, pageName, schema = [], noindex = false, cta = true, chips, nudge } = Astro.props;
const canonical = path === '/' ? `${SITE.url}/` : `${SITE.url}${path}`;
const graph = { '@context': 'https://schema.org', '@graph': [...baseGraph({ path, title, description }), ...schema] };
---
<!doctype html>
<html lang="es-CL" data-ga={SITE.ga4}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin>
  {noindex && <meta name="robots" content="noindex, follow">}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Zolutions AI">
  <meta property="og:locale" content="es_CL">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={`${SITE.url}/og.png`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#FFFFFF">
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head>
<body>
  <a class="skip" href="#main">Saltar al contenido</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  {cta && <CtaBand />}
  <Footer />
  <Chat pageName={pageName} chips={chips} nudge={nudge} />
  <div class="cookie" id="cookieBanner" hidden role="dialog" aria-label="Preferencias de cookies">
    <p>Usamos cookies analíticas para entender qué páginas sirven más. Solo se activan si las aceptas. Detalles en nuestra <a href="/privacidad">política de privacidad</a>.</p>
    <div class="r">
      <button class="btn btn-secondary btn-sm" type="button" id="cookieReject">Rechazar</button>
      <button class="btn btn-primary btn-sm" type="button" id="cookieAccept">Aceptar</button>
    </div>
  </div>
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
