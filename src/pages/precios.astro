---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Faq from '../components/Faq.astro';
import PlanCard from '../components/PlanCard.astro';
import { SITE, PFAQ } from '../data/site.mjs';
import { breadcrumb, faqPage, agentOffer } from '../lib/schema.mjs';

const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Precios', path: '/precios' }];
const schema = [
  breadcrumb(crumbs),
  {
    '@type': 'Product',
    name: 'Vendedor IA Básico',
    description: 'Agente comercial de IA en WhatsApp, web, Instagram y Facebook con 100 conversaciones al mes, implementación sin costo y sin permanencia.',
    brand: { '@type': 'Brand', name: 'Zolutions AI' },
    offers: agentOffer(),
  },
  faqPage(PFAQ),
];
---
<Base
  title="Precios de Vendedor IA y soluciones de IA | Zolutions AI"
  description="Vendedor IA Básico: $500.000 + IVA al mes con 100 conversaciones en WhatsApp, web, Instagram y Facebook. Sin costo de implementación ni permanencia."
  path="/precios"
  pageName="Precios"
  schema={schema}
  chips={['¿Qué cuenta como una conversación?', '¿Hay permanencia?', '¿Qué plan me conviene?']}
  nudge={['¿No sabes qué plan te conviene?', 'Cuéntame cuántas consultas recibes al mes.']}
>
  <section class="page-hero">
    <div class="wrap">
      <Crumbs items={[crumbs[0], { name: 'Precios' }]} />
      <p class="eyebrow">Precios</p>
      <h1 class="h-1">Precios claros, sin permanencia</h1>
      <p class="lead">Parte con Vendedor IA Básico y crece cuando lo necesites.</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="wrap plans">
      <PlanCard titleTag="h2" />
      <article class="price-card">
        <h2 class="h-3">Vendedor IA Avanzado</h2>
        <div class="price"><b class="quote">A medida</b></div>
        <p class="price-sub">Para equipos que venden todos los días</p>
        <ul class="checklist">
          <li>Todo lo del plan Básico</li>
          <li>Califica y cotiza con tu catálogo</li>
          <li>Seguimiento automático</li>
          <li>Conectado a tu CRM</li>
          <li>Más conversaciones al mes</li>
        </ul>
        <a class="btn btn-secondary" href={SITE.calendar} target="_blank" rel="noopener" data-track="agendar">Cotizar el Avanzado</a>
      </article>
      <article class="price-card">
        <h2 class="h-3">Solución de IA a medida</h2>
        <div class="price"><b class="quote">Por proyecto</b></div>
        <p class="price-sub">Tu idea, construida con IA</p>
        <ul class="checklist">
          <li>Apps y plataformas con IA</li>
          <li>Agentes para tu operación</li>
          <li>Automatización de procesos</li>
          <li>Integraciones con tus sistemas</li>
        </ul>
        <a class="btn btn-secondary" href="/soluciones/desarrollo-ia-a-medida">Ver soluciones a medida</a>
      </article>
    </div>
    <div class="wrap"><p class="muted small" style="margin-top:1.4rem">Valores en pesos chilenos (CLP) + IVA. Implementación sin costo en el plan Básico.</p></div>
  </section>

  <section class="section band-soft">
    <div class="wrap grid-2">
      <div class="head" style="margin-bottom:0;align-content:start">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="h-1">Cómo se cobra</h2>
        <p class="lead">¿Dudas con tu caso? Zoe te orienta en segundos.</p>
        <div><button class="btn btn-secondary" type="button" data-open-chat="¿Qué plan me conviene? Recibimos unas ___ consultas al mes">Preguntarle a Zoe</button></div>
      </div>
      <Faq items={PFAQ} />
    </div>
  </section>
</Base>
