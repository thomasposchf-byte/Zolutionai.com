---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import { INDUSTRIES } from '../data/site.mjs';
import { breadcrumb } from '../lib/schema.mjs';
---
<Base
  title="Soluciones de IA por industria | Zolutions AI"
  description="Agentes de IA para inmobiliarias, automotoras, clínicas, retail, educación y servicios B2B, entrenados con el lenguaje de tus clientes."
  path="/industrias"
  pageName="Industrias"
  schema={[breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Industrias', path: '/industrias' }])]}
  nudge={['¿No ves tu industria?', 'Cuéntame tu rubro y te digo cómo aplicaría.']}
>
  <section class="page-hero">
    <div class="wrap">
      <Crumbs items={[{ name: 'Inicio', path: '/' }, { name: 'Industrias' }]} />
      <p class="eyebrow">Industrias</p>
      <h1 class="h-1">IA para tu industria</h1>
      <p class="lead">Entrenamos a tu agente con el lenguaje y las preguntas de tus clientes.</p>
    </div>
  </section>
  <section class="section-sm">
    <div class="wrap grid-3">
      {INDUSTRIES.map(([name, items]) => (
        <article class="card" style="display:grid;gap:.8rem;align-content:start">
          <h2 class="h-3">{name}</h2>
          <ul class="checklist">{items.map((x) => <li>{x}</li>)}</ul>
          <button class="btn btn-secondary btn-sm" style="justify-self:start" type="button" data-open-chat={`Tengo una empresa del rubro ${name.toLowerCase()}. ¿Cómo me ayudaría la IA?`}>Preguntar por mi caso</button>
        </article>
      ))}
    </div>
  </section>
</Base>
