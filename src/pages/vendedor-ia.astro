---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import PlanCard from '../components/PlanCard.astro';
import { SITE, PRICE_LINE, VENDEDOR, INDUSTRIES, VFAQ } from '../data/site.mjs';
import { breadcrumb, faqPage, service } from '../lib/schema.mjs';

const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Vendedor IA', path: '/vendedor-ia' }];
const schema = [
  breadcrumb(crumbs),
  service({ name: 'Vendedor IA', description: 'Agente comercial con IA que responde, califica, agenda y deriva a tu equipo 24/7 en WhatsApp, web, Instagram y Facebook.', path: '/vendedor-ia', offer: true }),
  faqPage(VFAQ),
];
---
<Base
  title="Vendedor IA: agente comercial con IA 24/7 | Zolutions AI"
  description="Vendedor IA responde en segundos, califica, agenda reuniones y deriva a tu equipo en WhatsApp, web, Instagram y Facebook. Desde $500.000 + IVA al mes."
  path="/vendedor-ia"
  pageName="Vendedor IA"
  schema={schema}
  chips={['¿En qué se diferencia de un chatbot?', '¿Sirve para mi rubro?', '¿Cuánto cuesta?', 'Quiero una demo']}
  nudge={['¿Quieres verlo vendiendo en tu rubro?', 'Cuéntame a qué se dedica tu empresa.']}
>
  <section class="page-hero">
    <div class="wrap">
      <Crumbs items={[crumbs[0], { name: 'Vendedor IA' }]} />
      <p class="eyebrow">Producto estrella</p>
      <h1 class="h-1" style="max-width:20ch">Vendedor IA: tu agente comercial 24/7</h1>
      <p class="lead">Atiende en segundos, detecta quién quiere comprar y le agenda una reunión con tu equipo.</p>
      <div class="actions">
        <a class="btn btn-primary" href={SITE.calendar} target="_blank" rel="noopener" data-track="agendar">Agendar una demo</a>
        <button class="btn btn-secondary" type="button" data-open-chat="Quiero ver cómo vendería Vendedor IA en mi rubro">Pruébalo: habla con Zoe</button>
      </div>
      <div class="info"><span>Desde <b>{PRICE_LINE}</b></span><span><b>WhatsApp, web, Instagram y Facebook</b></span><span>Listo en <b>7 días</b></span></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Qué hace</p><h2 class="h-1">Lo que hace un buen vendedor, sin pausas</h2></div>
      <div class="grid-4">
        {VENDEDOR.map(([icon, t, d]) => (
          <div class="feature card"><span class="ico"><Icon name={icon} /></span><h3 class="h-3">{t}</h3><p>{d}</p></div>
        ))}
      </div>
      <p class="muted small" style="margin-top:1.2rem">Zoe, el agente de este sitio, es un Vendedor IA. Pruébalo abajo a la derecha.</p>
    </div>
  </section>

  <section class="section band-soft">
    <div class="wrap grid-2" style="align-items:center">
      <div class="head" style="margin-bottom:0">
        <p class="eyebrow">No es un chatbot</p>
        <h2 class="h-1">Un chatbot responde. Vendedor IA vende.</h2>
        <p class="lead">Conversa como una persona y siempre busca el siguiente paso de la venta.</p>
      </div>
      <div class="table-scroll">
        <table class="vs">
          <caption class="sr">Comparación entre un chatbot y Vendedor IA</caption>
          <thead><tr><th scope="col"><span class="sr">Aspecto</span></th><th scope="col">Chatbot</th><th scope="col" class="us">Vendedor IA</th></tr></thead>
          <tbody>
            <tr><th scope="row">Conversación</th><td>Menús y botones</td><td class="us">Lenguaje natural</td></tr>
            <tr><th scope="row">Objetivo</th><td>Responder</td><td class="us">Vender</td></tr>
            <tr><th scope="row">Si no sabe</th><td>“No entendí”</td><td class="us">Te deriva el cliente</td></tr>
            <tr><th scope="row">Resultado</th><td>Consultas atendidas</td><td class="us">Reuniones y ventas</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Planes</p><h2 class="h-1">Parte simple y crece cuando lo necesites</h2></div>
      <div class="grid-2">
        <PlanCard />
        <article class="price-card">
          <h3 class="h-3">Vendedor IA Avanzado</h3>
          <div class="price"><b class="quote">A medida</b></div>
          <p class="price-sub">Para equipos que venden todos los días</p>
          <ul class="checklist">
            <li>Todo lo del plan Básico</li>
            <li>Califica y cotiza con tu catálogo</li>
            <li>Seguimiento automático</li>
            <li>Conectado a tu CRM</li>
            <li>Más conversaciones al mes</li>
          </ul>
          <a class="btn btn-secondary" href={SITE.calendar} target="_blank" rel="noopener" data-track="agendar">Cotizar el Avanzado</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="wrap grid-2">
      <div>
        <div class="head"><p class="eyebrow">Implementación</p><h2 class="h-2">Funcionando en 7 días</h2></div>
        <ol class="timeline" style="grid-template-columns:minmax(0,1fr)">
          <li><span class="d">Días 1 y 2</span><b>Lo entrenamos</b><p>Con tu catálogo, precios y preguntas frecuentes.</p></li>
          <li><span class="d">Días 3 a 5</span><b>Lo conectamos</b><p>A tus canales y calendario, y lo probamos con tu equipo.</p></li>
          <li><span class="d">Días 6 y 7</span><b>Sale a vender</b><p>Y lo ajustamos cada semana según los resultados.</p></li>
        </ol>
      </div>
      <div>
        <div class="head"><p class="eyebrow">Industrias</p><h2 class="h-2">Funciona en tu rubro</h2></div>
        <div class="inds">{INDUSTRIES.map(([n]) => <a href="/industrias">{n}</a>)}</div>
        <p class="muted" style="margin-top:1.2rem">Si tus clientes preguntan antes de comprar, Vendedor IA puede responderles y venderles.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="head" style="margin-bottom:0"><p class="eyebrow">Preguntas frecuentes</p><h2 class="h-2">Sobre Vendedor IA</h2></div>
      <Faq items={VFAQ} />
    </div>
  </section>
</Base>
