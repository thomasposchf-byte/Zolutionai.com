---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import PlanCard from '../components/PlanCard.astro';
import CaseCard from '../components/CaseCard.astro';
import { SITE, PRICE_LINE, VENDEDOR, BUILD, BUILD_STEPS, CASES, SOLUTIONS, FAQ } from '../data/site.mjs';
import { faqPage } from '../lib/schema.mjs';
const custom = SOLUTIONS[0];
const others = SOLUTIONS.slice(2);
---
<Base
  title="Agentes de IA para empresas en Chile | Zolutions AI"
  description="Creamos agentes de IA que venden 24/7 en WhatsApp y web, y soluciones de IA a medida para tu empresa. Vendedor IA desde $500.000 + IVA al mes."
  path="/"
  pageName="Inicio"
  schema={[faqPage(FAQ)]}
  nudge={['¿Tus clientes escriben de noche?', 'Pregúntame cómo responderles al instante.']}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Agentes y soluciones de IA para empresas</p>
        <h1 class="h-hero" style="margin-top:1rem">IA que <span class="hl">vende</span> y <span class="hl">trabaja</span> por tu empresa</h1>
        <p class="lead">Agentes que atienden y venden 24/7, y software con IA hecho a la medida de tu negocio.</p>
        <div class="actions">
          <a class="btn btn-primary" href={SITE.calendar} target="_blank" rel="noopener" data-track="agendar">Agendar evaluación gratis</a>
          <button class="btn btn-secondary" type="button" data-open-chat="Hola, quiero ver cómo funcionaría un agente IA en mi empresa">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4h12v9H8l-4 3z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
            Hablar con nuestro agente
          </button>
        </div>
        <p class="hero-note"><span>Desde <b>{PRICE_LINE}</b></span><span>Sin permanencia</span><span>Listo en 7 días</span></p>
      </div>

      <figure class="demo" aria-label="Ejemplo de un agente de IA atendiendo a un cliente de una inmobiliaria por WhatsApp">
        <div class="demo-head">
          <span class="avatar"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1C12 7.1 16.9 12 23 12 16.9 12 12 16.9 12 23 12 16.9 7.1 12 1 12 7.1 12 12 7.1 12 1Z" fill="#fff"/></svg></span>
          <span class="who"><b>Inmobiliaria · WhatsApp</b><span class="online">Agente IA respondiendo</span></span>
          <span class="tag">Ejemplo</span>
        </div>
        <div class="convo">
          <div class="msg in">Hola, ¿sigue disponible el depto de 2 dormitorios en Ñuñoa?<time>23:47</time></div>
          <div class="msg out"><span class="flag">Respondió en 4 s</span><br>¡Sí! 2D/2B, 68 m² con estacionamiento. ¿Es para vivir o invertir?<time>23:47</time></div>
          <div class="msg in">Para vivir. Tengo crédito preaprobado.<time>23:48</time></div>
          <div class="msg out">Perfecto. ¿Te agendo una visita el sábado a las 11:00?<time>23:48</time></div>
          <div class="msg in">Sí, dale.<time>23:49</time></div>
        </div>
        <dl class="ficha">
          <div><dt>Interés</dt><dd>Alto</dd></div>
          <div><dt>Siguiente paso</dt><dd class="okc">Visita sáb 11:00</dd></div>
          <div><dt>Derivado a</dt><dd>Equipo de ventas</dd></div>
        </dl>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <div class="head">
          <p class="eyebrow">Vendedor IA</p>
          <h2 class="h-1">Tu vendedor que no duerme</h2>
          <p class="lead">Atiende en WhatsApp, web, Instagram y Facebook, y te entrega clientes listos para cerrar.</p>
        </div>
        <ul class="mini">
          {VENDEDOR.map(([icon, t, d]) => (
            <li><span class="ico"><Icon name={icon} /></span><span><b>{t}</b>{d}</span></li>
          ))}
        </ul>
        <div class="actions"><a class="btn btn-secondary" href="/vendedor-ia">Cómo funciona</a></div>
      </div>
      <PlanCard title="Plan Básico" />
    </div>
  </section>

  <section class="section band-dark">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Soluciones de IA a medida</p>
        <h2 class="h-1">¿Tienes una idea o un proceso? Lo construimos con IA.</h2>
        <p class="lead">Diseñamos y desarrollamos software con IA para tu negocio, del prototipo al producto en uso.</p>
      </div>
      <div class="build">
        {BUILD.map(([icon, t, d]) => (
          <div class="build-item"><span class="ico"><Icon name={icon} /></span><h3 class="h-3">{t}</h3><p>{d}</p></div>
        ))}
      </div>
      <ol class="steps">{BUILD_STEPS.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ol>
      <div class="actions">
        <button class="btn btn-light" type="button" data-open-chat="Tengo una idea para una solución con IA: ">Cuéntanos tu idea</button>
        <a class="btn btn-outline-light" href={custom.path}>Ver soluciones a medida</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Casos de éxito</p>
        <h2 class="h-1">Proyectos que ya funcionan con IA</h2>
      </div>
      <div class="cases">{CASES.map((c) => <CaseCard c={c} />)}</div>
      <p class="more">Más soluciones: {others.map((s) => <a href={s.path}>{s.name}</a>)}</p>
    </div>
  </section>

  <section class="section band-soft">
    <div class="wrap grid-2">
      <div class="head" style="margin-bottom:0;align-content:start">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="h-1">Antes de partir</h2>
        <p class="lead">¿Otra duda? Zoe, nuestro agente, te responde al instante.</p>
        <div><button class="btn btn-secondary" type="button" data-open-chat="">Preguntarle a Zoe</button></div>
      </div>
      <Faq items={FAQ} />
    </div>
  </section>
</Base>
