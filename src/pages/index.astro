---
import Base from '../layouts/Base.astro';
import SolutionGrid from '../components/SolutionGrid.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import AgentPlan from '../components/AgentPlan.astro';
import { SITE, INDUSTRIES, FAQ } from '../data/site.mjs';
import { faqPage } from '../lib/schema.mjs';
---
<Base
  title="Agentes de IA para empresas en Chile | Zolutions AI"
  description="Creamos agentes de IA que responden, califican y venden por tu empresa 24/7 en WhatsApp y web. Implementación en unos 7 días. Agenda una evaluación gratis."
  path="/"
  pageName="Inicio"
  schema={[faqPage(FAQ)]}
  nudge={['¿Tus clientes escriben de noche?', 'Pregúntame cómo un agente IA les respondería al instante.']}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Agentes de IA para empresas · Santiago, Chile</p>
        <h1 class="h-hero" style="margin-top:1rem">Agentes de IA que <em>venden</em> por tu empresa, 24/7</h1>
        <p class="lead">Creamos Vendedor IA y automatizaciones que responden en segundos, califican a cada prospecto y le entregan a tu equipo reuniones agendadas. Sin ampliar tu equipo comercial.</p>
        <div class="actions">
          <button class="btn btn-primary" type="button" data-open-chat="Hola, quiero ver cómo funcionaría un agente IA en mi empresa">
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4h12v9H8l-4 3z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
            Habla con nuestro agente ahora
          </button>
          <a class="btn btn-ghost" href={SITE.calendar} target="_blank" rel="noopener" data-track="agendar">Agendar evaluación gratis</a>
        </div>
        <p class="hero-note">Desde <b>US$500 al mes + IVA</b> · Implementación sin costo · Sin permanencia</p>
        <div class="facts">
          <div class="fact"><b>Segundos</b><span>Tiempo de primera respuesta</span></div>
          <div class="fact"><b>24/7</b><span>Atención todos los días del año</span></div>
          <div class="fact"><b>~7 días</b><span>Para tener tu agente funcionando</span></div>
        </div>
      </div>

      <figure class="demo" style="margin:0" aria-label="Ejemplo de conversación de Vendedor IA con un cliente de una inmobiliaria">
        <div class="demo-head">
          <span class="avatar">IA</span>
          <span class="who"><b>Vendedor IA · Inmobiliaria</b><span class="online">Respondiendo ahora</span></span>
          <span class="tag">Ejemplo</span>
        </div>
        <div class="convo">
          <div class="msg in">Hola, vi el depto de 2 dormitorios en Ñuñoa. ¿Sigue disponible?<time>23:47</time></div>
          <div class="msg out"><span class="flag">Respondió en 4 s</span><br>¡Hola! Sí, sigue disponible: 2D/2B, 68 m² y estacionamiento incluido. ¿Lo buscas para vivir o para invertir?<time>23:47</time></div>
          <div class="msg in">Para vivir. Tengo crédito preaprobado.<time>23:48</time></div>
          <div class="msg out">Perfecto. Te puedo agendar una visita: ¿te acomoda el sábado a las 11:00 o a las 16:00?<time>23:48</time></div>
          <div class="msg in">Sábado 11.<time>23:49</time></div>
          <div class="msg out">Listo, visita confirmada para el sábado a las 11:00. Te envié la ubicación; Camila, del equipo, te recibirá.<time>23:49</time></div>
        </div>
        <dl class="ficha">
          <div><dt>Interés</dt><dd class="hot">Alto</dd></div>
          <div><dt>Financiamiento</dt><dd>Preaprobado</dd></div>
          <div><dt>Siguiente paso</dt><dd class="okc">Visita sáb 11:00</dd></div>
          <div><dt>Derivado a</dt><dd>Camila (ventas)</dd></div>
        </dl>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">El problema</p>
        <h2 class="h-1">¿En qué momento se pierden tus ventas?</h2>
        <p class="lead">Casi nunca es el producto. Las ventas se escapan entre que el cliente escribe y alguien le responde, o cuando nadie le hace seguimiento.</p>
      </div>
      <div class="grid-3">
        <div class="leak">
          <span class="now">Hoy</span>
          <h3 class="h-3">Respuestas que llegan tarde</h3>
          <p class="muted">El cliente escribe a las 23:00, le respondes al otro día y ya le compró a quien contestó primero.</p>
          <p class="fix"><b>Con IA:</b> respuesta en segundos, a cualquier hora, con tu información y tu tono.</p>
        </div>
        <div class="leak">
          <span class="now">Hoy</span>
          <h3 class="h-3">Seguimiento que nadie hace</h3>
          <p class="muted">Cotizaciones enviadas que quedan esperando una respuesta que nunca llega.</p>
          <p class="fix"><b>Con IA:</b> seguimiento automático por WhatsApp y email en el momento justo.</p>
        </div>
        <div class="leak">
          <span class="now">Hoy</span>
          <h3 class="h-3">Tu equipo atrapado en tareas repetitivas</h3>
          <p class="muted">Las mismas preguntas, la misma información copiada de una planilla a otra todos los días.</p>
          <p class="fix"><b>Con IA:</b> tu equipo solo atiende a prospectos calificados y listos para cerrar.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-paper">
    <div class="wrap compare">
      <div class="section-head" style="margin-bottom:0">
        <p class="eyebrow">Producto estrella</p>
        <h2 class="h-1">Vendedor IA no es un chatbot. Es un vendedor.</h2>
        <p class="lead">Un agente comercial digital entrenado con tu catálogo, tus precios y tu forma de vender. Su único objetivo es llevar a cada cliente al siguiente paso de la compra.</p>
        <div class="actions" style="margin-top:.6rem"><a class="btn btn-dark" href="/vendedor-ia">Conocer Vendedor IA</a></div>
      </div>
      <div class="table-scroll">
        <table class="vs">
          <caption class="sr">Comparación entre un chatbot tradicional y Vendedor IA</caption>
          <thead><tr><th scope="col"><span class="sr">Aspecto</span></th><th scope="col">Chatbot tradicional</th><th scope="col" class="us">Vendedor IA</th></tr></thead>
          <tbody>
            <tr><th scope="row">Objetivo</th><td>Responder preguntas</td><td class="us">Llevar al cliente a comprar</td></tr>
            <tr><th scope="row">Conversación</th><td>Menús y palabras clave</td><td class="us">Lenguaje natural, recuerda el contexto</td></tr>
            <tr><th scope="row">Calificación</th><td>No califica</td><td class="us">Detecta necesidad, presupuesto y urgencia</td></tr>
            <tr><th scope="row">Seguimiento</th><td>Espera a que el cliente vuelva</td><td class="us">Retoma la conversación sola</td></tr>
            <tr><th scope="row">Si no sabe algo</th><td>“No entendí tu pregunta”</td><td class="us">Deriva a tu equipo con un resumen</td></tr>
            <tr><th scope="row">Resultado</th><td>Consultas atendidas</td><td class="us">Reuniones y ventas</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Soluciones</p>
        <h2 class="h-1">Todo lo que necesitas para vender con IA</h2>
        <p class="lead">Partimos por donde más retorno tiene tu empresa y conectamos el resto cuando lo necesites.</p>
      </div>
      <SolutionGrid />
    </div>
  </section>

  <section class="section band-surface">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Nuestra diferencia</p>
        <h2 class="h-1">Conectamos el embudo completo, del anuncio a la reunión</h2>
        <p class="lead">La mayoría de los proveedores resuelve una sola parte. Nosotros unimos tus campañas, tus conversaciones y tu seguimiento para que cada peso invertido en anuncios termine en una venta medible.</p>
      </div>
      <div class="funnel-bar" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <ol class="funnel" style="list-style:none;padding:0;margin:0">
        <li class="stage"><span class="n">Etapa 1</span><h3 class="h-3">Atraer</h3><p>Campañas de Ads optimizadas con IA según qué anuncios generan ventas, no clics.</p><a class="svc" href="/soluciones/optimizacion-ads-ia">Optimización de Ads con IA</a></li>
        <li class="stage"><span class="n">Etapa 2</span><h3 class="h-3">Conversar</h3><p>Vendedor IA responde en segundos por WhatsApp, web, Instagram o Facebook y califica a cada prospecto.</p><a class="svc" href="/vendedor-ia">Vendedor IA</a></li>
        <li class="stage"><span class="n">Etapa 3</span><h3 class="h-3">Seguir</h3><p>Seguimientos automáticos y registro en tu CRM. Ningún prospecto queda sin su siguiente paso.</p><a class="svc" href="/soluciones/automatizacion-comercial">Automatización comercial</a></li>
        <li class="stage"><span class="n">Etapa 4</span><h3 class="h-3">Cerrar</h3><p>Tu equipo recibe reuniones agendadas con prospectos calificados y el resumen de cada conversación.</p><a class="svc" href="/soluciones/integraciones-ia">Integraciones con tu equipo</a></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 class="h-1">De la primera conversación a tu IA funcionando</h2>
      </div>
      <Steps />
      <div class="pillars">
        <div class="pillar"><b>Implementación rápida</b><span>Un agente conversacional en unos 7 días.</span></div>
        <div class="pillar"><b>Resultados medibles</b><span>Panel con conversaciones, prospectos y reuniones.</span></div>
        <div class="pillar"><b>Datos protegidos</b><span>Accesos controlados a tu información.</span></div>
        <div class="pillar"><b>Soporte experto 24/7</b><span>Incluido en todas nuestras soluciones.</span></div>
      </div>
    </div>
  </section>

  <section class="section band-surface">
    <div class="wrap home-price">
      <div class="section-head" style="margin-bottom:0">
        <p class="eyebrow">Precios</p>
        <h2 class="h-1">Tu agente de IA desde US$500 al mes</h2>
        <p class="lead">Un agente conversacional omnicanal con 100 conversaciones al mes, implementación sin costo y sin permanencia. Para vender con Vendedor IA o llevar la IA a todo tu proceso comercial, armamos un plan a tu medida.</p>
        <div class="actions" style="margin-top:.4rem">
          <a class="btn btn-primary" href="/precios">Ver planes y qué incluyen</a>
          <button class="btn btn-ghost" type="button" data-open-chat="¿Qué plan me conviene para mi empresa?">¿Cuál me conviene?</button>
        </div>
      </div>
      <AgentPlan />
    </div>
  </section>

  <section class="section band-paper">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Industrias</p>
        <h2 class="h-1">Funciona en casi cualquier industria</h2>
        <p class="lead">Si tus clientes hacen preguntas antes de comprar, un agente IA puede responderlas y vender.</p>
      </div>
      <div class="inds">{INDUSTRIES.map(([n]) => <a class="ind-chip" href="/industrias">{n}</a>)}</div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div class="section-head" style="margin-bottom:0;align-content:start">
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="h-1">Lo que nos preguntan antes de partir</h2>
        <p class="lead">¿Tienes otra duda? Zoe, nuestro agente, te responde al instante.</p>
        <div><button class="btn btn-ghost" type="button" data-open-chat="">Preguntarle a Zoe</button></div>
      </div>
      <Faq items={FAQ} />
    </div>
  </section>
</Base>
