---
import Base from '../layouts/Base.astro';
---
<Base
  title="Página no encontrada | Zolutions AI"
  description="La página que buscas no existe."
  path="/404"
  pageName="Página no encontrada"
  noindex
>
  <section class="page-hero">
    <div class="wrap thanks">
      <p class="eyebrow">Error 404</p>
      <h1 class="h-1">Esta página no existe</h1>
      <p class="lead">Puede que el enlace esté mal escrito o que la página haya cambiado de lugar.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Ir al inicio</a>
        <a class="btn btn-secondary" href="/soluciones">Ver soluciones</a>
      </div>
    </div>
  </section>
</Base>
