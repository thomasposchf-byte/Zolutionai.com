---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import SolutionGrid from '../../components/SolutionGrid.astro';
import { PRICE_LINE, SOLUTIONS } from '../../data/site.mjs';
import { breadcrumb } from '../../lib/schema.mjs';

const custom = SOLUTIONS[0];
const schema = [
  breadcrumb([{ name: 'Inicio', path: '/' }, { name: 'Soluciones', path: '/soluciones' }]),
  {
    '@type': 'ItemList',
    itemListElement: [{ name: 'Vendedor IA', path: '/vendedor-ia' }, ...SOLUTIONS].map((s, i) => ({
      '@type': 'ListItem', position: i + 1, name: s.name, url: `https://zolutionsai.com${s.path}`,
    })),
  },
];
---
<Base
  title="Soluciones de IA para empresas | Zolutions AI"
  description="Vendedor IA, soluciones de IA a medida, agentes para WhatsApp, automatización comercial, Ads con IA, integraciones y asesoría para empresas."
  path="/soluciones"
  pageName="Soluciones"
  schema={schema}
>
  <section class="page-hero">
    <div class="wrap">
      <Crumbs items={[{ name: 'Inicio', path: '/' }, { name: 'Soluciones' }]} />
      <p class="eyebrow">Soluciones</p>
      <h1 class="h-1">Soluciones de inteligencia artificial para empresas</h1>
      <p class="lead">Parte por lo que más necesitas. Todo se conecta después.</p>
    </div>
  </section>
  <section class="section-sm">
    <div class="wrap">
      <div class="paths">
        <a class="path" href="/vendedor-ia">
          <span class="ico"><Icon name="chat" /></span>
          <h2 class="h-2">Vendedor IA</h2>
          <p>Atiende, califica y agenda 24/7 en WhatsApp, web, Instagram y Facebook.</p>
          <ul><li>Desde {PRICE_LINE}</li></ul>
          <span class="link">Conocer Vendedor IA →</span>
        </a>
        <a class="path alt" href={custom.path}>
          <span class="ico"><Icon name="app" /></span>
          <h2 class="h-2">{custom.name}</h2>
          <p>{custom.short}</p>
          <ul><li>Del prototipo al producto</li></ul>
          <span class="link">Ver soluciones a medida →</span>
        </a>
      </div>
      <h2 class="h-2" style="margin:2.6rem 0 1.2rem">Más soluciones</h2>
      <SolutionGrid skipCustom />
    </div>
  </section>
</Base>
