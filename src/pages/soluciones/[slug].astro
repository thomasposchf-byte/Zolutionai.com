---
import SolutionPage from '../../components/SolutionPage.astro';
import { SOLUTIONS } from '../../data/site.mjs';

// La página de soluciones a medida tiene su propio diseño (desarrollo-ia-a-medida.astro).
export function getStaticPaths() {
  return SOLUTIONS.filter((s) => s.path.startsWith('/soluciones/') && s.key !== 'desarrollo-a-medida').map((s) => ({
    params: { slug: s.path.replace('/soluciones/', '') },
    props: { solKey: s.key },
  }));
}
const { solKey } = Astro.props;
---
<SolutionPage solKey={solKey} />
