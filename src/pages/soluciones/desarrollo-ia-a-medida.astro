---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import CaseCard from '../../components/CaseCard.astro';
import { SITE, SOLUTIONS, BUILD, BUILD_STEPS, CASES } from '../../data/site.mjs';
import { breadcrumb, faqPage, service } from '../../lib/schema.mjs';

const s = SOLUTIONS[0];
const crumbs = [{ name: 'Inicio', path: '/' }, { name: 'Soluciones', path: '/soluciones' }, { name: s.name, path: s.path }];
const schema = [breadcrumb(crumbs), service({ name: s.name, description: s.lead, path: s.path }), faqPage(s.faq)];
const ideas = [
  'Una app para tus clientes que use IA',
  'Un agente interno que responda a tu equipo',
  'Leer documentos, fotos o facturas automáticamente',
  'Un panel que resuma tu operación cada día',
];
---
<Base
  title={s.seo.title}
  description={s.seo.desc}
  path={s.path}
  pageName={s.name}
  schema={schema}
  chips={['Tengo una idea para una app', '¿Cuánto demora un proyecto?', '¿Cuánto cuesta?', 'Quiero una evaluación']}
  nudge={['¿Tienes una idea?', 'Cuéntamela y te digo cómo la construiríamos.']}
>
  <section class="page-hero">
    <div class="wrap">
      <Crumbs items={[crumbs[0], crumbs[1], { name: s.name }]} />
      <p class="eyebrow">Soluciones a medida</p>
      <h1 class="h-1" style="max-width:20ch">Tu idea, construida con inteligencia artificial</h1>
      <p class="lead">{s.lead}</p>
      <div class="actions">
        <button class="btn btn-primary" type="button" data-open-chat="Tengo una idea para una solución con IA: ">Cuéntanos tu idea</button>
        <a class="btn btn-secondary" href={SITE.calendar} target="_blank" rel="noopener" data-track="agendar">Agendar evaluación gratis</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Qué construimos</p><h2 class="h-1">Software con IA para tu negocio</h2></div>
      <div class="grid-4">
        {BUILD.map(([icon, t, d]) => (
          <div class="feature card"><span class="ico"><Icon name={icon} /></span><h3 class="h-3">{t}</h3><p>{d}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-dark">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Cómo trabajamos</p><h2 class="h-1">De la idea al producto, en 4 pasos</h2><p class="lead">Validamos rápido con un prototipo antes de invertir en el producto completo.</p></div>
      <ol class="steps">{BUILD_STEPS.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Casos de éxito</p><h2 class="h-1">Lo que ya construimos</h2></div>
      <div class="cases">{CASES.map((c) => <CaseCard c={c} />)}</div>
    </div>
  </section>

  <section class="section band-soft">
    <div class="wrap grid-2">
      <div>
        <div class="head"><p class="eyebrow">Ideas para empezar</p><h2 class="h-2">¿No sabes por dónde partir?</h2></div>
        <ul class="checklist">{ideas.map((i) => <li>{i}</li>)}</ul>
        <div class="actions"><button class="btn btn-primary" type="button" data-open-chat="Quiero ideas de IA para mi empresa. Mi rubro es: ">Pedir ideas para mi empresa</button></div>
      </div>
      <div>
        <div class="head"><p class="eyebrow">Preguntas frecuentes</p><h2 class="h-2">Sobre proyectos a medida</h2></div>
        <Faq items={s.faq} />
      </div>
    </div>
  </section>
</Base>
