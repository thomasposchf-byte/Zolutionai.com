---
// Agente Zoe: botón flotante, burbuja proactiva y ventana de chat. La lógica está en src/scripts/chat.js.
import { SITE, waLink } from '../data/site.mjs';
import Spark from './Spark.astro';
interface Props { chips?: string[]; nudge?: [string, string]; pageName: string }
const { chips = ['¿Qué es Vendedor IA?', '¿Cuánto cuesta?', 'Tengo una idea para una app', 'Quiero una evaluación'], nudge, pageName } = Astro.props;
---
<div id="zoe-root" data-page={pageName} data-cal={SITE.calendar} data-wa={SITE.whatsapp} data-wa-shown={SITE.whatsappDisplay}>
  {nudge && (
    <div class="zoe-nudge" id="zoeNudge" hidden role="button" tabindex="0">
      <button class="x" id="nudgeX" type="button" aria-label="Cerrar">×</button>
      <span><b>{nudge[0]}</b> {nudge[1]}</span>
    </div>
  )}
  <button class="zoe-launch" id="zoeLaunch" type="button" aria-controls="zoe" aria-expanded="false">
    <span class="avatar"><Spark white /></span>
    <span class="t">¿Hablamos?<small>Respondo al instante</small></span>
  </button>
  <section class="zoe" id="zoe" hidden aria-label="Chat con Zoe, agente IA de Zolutions">
    <div class="zoe-head">
      <span class="avatar"><Spark white /></span>
      <div class="who"><b>Zoe · Agente IA</b><span class="status on" id="zoeStatus">En línea · responde en segundos</span></div>
      <button class="icon-btn sq" id="zoeClose" type="button" aria-label="Cerrar chat"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
    </div>
    <button class="zoe-human" id="humanBtn" type="button">¿Prefieres hablar con una persona? <b>Déjanos tus datos</b></button>
    <div class="zoe-log" id="zoeLog" aria-live="polite"></div>
    <div class="zoe-chips" id="zoeChips">
      {chips.map((c) => <button class="chip" type="button" data-chip={c}>{c}</button>)}
    </div>
    <form class="zoe-input" id="zoeForm">
      <label class="sr" for="zoeText">Escribe tu mensaje</label>
      <textarea id="zoeText" rows="1" maxlength="1500" placeholder="Escribe tu pregunta…"></textarea>
      <button class="send" id="zoeSend" type="submit" aria-label="Enviar"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </form>
    <div class="zoe-foot">Zoe es una IA y puede equivocarse. Un especialista confirma cada propuesta. <a href="/privacidad">Privacidad</a></div>
  </section>
  <noscript><a class="zoe-launch" href={waLink()}>Escríbenos por WhatsApp</a></noscript>
</div>

<script>
  import '../scripts/chat.js';
</script>
