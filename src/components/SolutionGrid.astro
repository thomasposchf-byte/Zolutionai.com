---
import Icon from './Icon.astro';
import { SOLUTIONS } from '../data/site.mjs';
interface Props { heading?: 'h2' | 'h3'; skipCustom?: boolean }
const { heading = 'h3', skipCustom = false } = Astro.props;
const H = heading;
const items = skipCustom ? SOLUTIONS.slice(1) : SOLUTIONS;
---
<div class="grid-3">
  {items.map((s) => (
    <a class="path" href={s.path}>
      <span class="ico"><Icon name={s.icon} /></span>
      <H class="h-3">{s.name}</H>
      <p>{s.short}</p>
      <span class="link">Ver más →</span>
    </a>
  ))}
</div>
