---
import { SITE, waLink } from '../data/site.mjs';
---
<section class="cta">
  <div class="wrap">
    <div>
      <h2 class="h-1">¿Hablamos de tu proyecto?</h2>
      <p>Evaluación gratis y sin compromiso. Te decimos dónde la IA te hace vender o ahorrar más.</p>
    </div>
    <div class="actions">
      <a class="btn btn-light" href={SITE.calendar} target="_blank" rel="noopener" data-track="agendar">Agendar evaluación gratis</a>
      <a class="btn btn-outline-light" href={waLink('Hola, vengo de la web de Zolutions AI')} target="_blank" rel="noopener" data-track="whatsapp">Escribir por WhatsApp</a>
    </div>
  </div>
</section>
