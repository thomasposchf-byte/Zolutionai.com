---
import { SITE, waLink } from '../data/site.mjs';
---
<section class="cta">
  <div class="wrap">
    <div>
      <h2 class="h-1">¿Cuántas ventas se te escapan cada noche?</h2>
      <p>Agenda una evaluación gratis y te mostramos cómo se vería un Vendedor IA en tu empresa.</p>
    </div>
    <div class="actions">
      <a class="btn btn-dark" href={SITE.calendar} target="_blank" rel="noopener" data-track="agendar">Agendar evaluación gratis</a>
      <a class="btn btn-ghost" href={waLink('Hola, vengo de la web de Zolutions AI')} target="_blank" rel="noopener" data-track="whatsapp">Escribir por WhatsApp</a>
    </div>
  </div>
</section>
