---
interface Props { items: { name: string; path?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Ruta">
  {items.map((it, i) => (
    <>
      {i > 0 && <span aria-hidden="true">/</span>}
      {it.path ? <a href={it.path}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
    </>
  ))}
</nav>
