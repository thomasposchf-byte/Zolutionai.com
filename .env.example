# Clave de la API de Claude (console.anthropic.com). Se configura en Netlify:
# Site configuration > Environment variables. Nunca la subas al repositorio.
ANTHROPIC_API_KEY=

# Opcional: modelo y nivel de esfuerzo del agente Zoe.
# ZOE_MODEL=claude-opus-5-5
# ZOE_EFFORT=low

# Opcional: dominios extra desde donde se permite usar el chat (separados por coma).
# ALLOWED_ORIGINS=https://zolutionsai.com
